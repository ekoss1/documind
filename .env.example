# Copy this file to .env and fill in real values.
# Never put real secrets in this file.

# Claude API
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Postgres (Docker). Port 5433 because Homebrew Postgres uses 5432.
POSTGRES_USER=documind
POSTGRES_PASSWORD=change-me
POSTGRES_DB=documind
DATABASE_URL=postgresql+asyncpg://documind:change-me@localhost:5433/documind

# Redis (Docker)
REDIS_URL=redis://localhost:6379/0

# Ollama (local embeddings, runs on the Mac)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
